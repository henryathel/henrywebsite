# CloudFront checks the signed cookies against this public key. The private half was
# generated by scripts/create-signing-key.sh and stored straight into SSM, so it never
# passes through Terraform or its state.

resource "aws_cloudfront_public_key" "cookie_signing" {
  name_prefix = "${var.project}-cookie-signing-"
  comment     = "Verifies signed cookies for /roles/*"
  encoded_key = var.signing_public_key_pem

  # Rotation replaces the key; the new one must join the key group before the old leaves.
  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_cloudfront_key_group" "roles" {
  name    = "${var.project}-roles"
  comment = "Keys trusted for signed cookies on /roles/*"
  items   = [aws_cloudfront_public_key.cookie_signing.id]
}
